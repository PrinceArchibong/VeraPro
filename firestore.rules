rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'arisrael549@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().keys().hasAll(['uid', 'email', 'role', 'displayName']) &&
        incoming().uid == request.auth.uid;
      allow update: if (isOwner(userId) || isAdmin()) &&
        incoming().uid == existing().uid;
      allow delete: if isAdmin();
    }

    // Professionals collection (Publicly visible trust profiles, updatable by owner or admin)
    match /professionals/{userId} {
      allow read: if true; // Public marketplace profiles
      allow create: if (isOwner(userId) || isAdmin()) &&
        incoming().uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Sensitive Verification & KYC Records (Strictly private: applicant or admin only)
    match /verifications/{verificationId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Proctored tests
    match /tests/{testId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Process Evidence items (Publicly auditable proof or restricted)
    match /evidence/{evidenceId} {
      allow read: if true; // Public process proof
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if true; // Public marketplace jobs
      allow create: if isSignedIn() && incoming().clientId == request.auth.uid;
      allow update: if isSignedIn() && (existing().clientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().clientId == request.auth.uid || isAdmin());
    }

    // Escrow Contracts
    match /escrows/{escrowId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().clientId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().clientId == request.auth.uid ||
        existing().professionalId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Reports and flags
    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // References
    match /references/{referenceId} {
      allow read: if true; // Public verified references
      allow create: if isSignedIn() && (incoming().professionalId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
